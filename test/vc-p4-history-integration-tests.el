;;; vc-p4-history-integration-tests.el --- Submitted P4 ancestry -*- lexical-binding: t; -*-
(require 'vc-p4-integration-tests)
(require 'vc-p4-history)

(ert-deftest vc-p4-real-history-native-log-and-ancestral-revisions ()
  (let* ((file (vc-p4-integration-file "history-moved.txt"))
         (directory (file-name-directory file))
         (bytes (vc-p4--local-bytes file))
         (opened (vc-p4--query directory "opened"))
         (views nil) (finished nil)
         (vc-log-finish-functions (list (lambda () (setq finished t)))))
    (save-window-excursion
      (unwind-protect
          (progn
            (vc-print-log-internal 'P4 (list file) nil nil 20)
            (vc-p4-integration-drain)
            (should finished)
            (should (derived-mode-p 'vc-p4-log-view-mode))
            (goto-char (point-min)) (re-search-forward "^Revision: ")
            (should (equal (log-view-current-tag) "//depot/history-moved.txt#1"))
            (should (equal (log-view-current-file) file))
            (should (string-match-p "branch from //depot/history-source.txt" (buffer-string)))
            (should (string-match-p "    full description" (buffer-string)))
            (should buffer-read-only)
            (cl-letf (((symbol-function 'vc-p4--run)
                       (lambda (&rest _) (ert-fail "History used synchronous P4"))))
              (log-view-find-revision (point))
              (set-buffer (window-buffer (selected-window)))
              (push (current-buffer) views)
              (vc-p4-integration-drain)
              (should (equal (buffer-string) "branch edit\nshared original\n"))
              (should-not buffer-file-name)
              (should buffer-read-only)
              (dolist (expected '(("//depot/history-branch.txt#1" . "history two\nshared original\n")
                                  ("//depot/history-source.txt#2" . "history two\nshared original\n")
                                  ("//depot/history-source.txt#1" . "history one\nshared original\n")))
                (vc-p4-revision-previous)
                (push (current-buffer) views)
                (vc-p4-integration-drain)
                (should (equal vc-buffer-revision (car expected)))
                (should (equal (buffer-string) (cdr expected))))
              (should-error (vc-p4-revision-previous) :type 'user-error)
              (vc-p4-revision-next)
              (should (equal vc-buffer-revision "//depot/history-source.txt#2")))
            (should (equal (vc-p4--local-bytes file) bytes))
            (should (equal (vc-p4--query directory "opened") opened)))
        (dolist (buffer views) (when (buffer-live-p buffer) (kill-buffer buffer)))
        (when (get-buffer "*vc-change-log*") (kill-buffer "*vc-change-log*"))))))

(provide 'vc-p4-history-integration-tests)

(ert-deftest vc-p4-real-history-changes-describe-and-unrelated-file ()
  (let* ((file (vc-p4-integration-file "history-moved.txt"))
         (directory (file-name-directory file))
         (opened (vc-p4--query directory "opened"))
         (change (alist-get 'headChange (vc-p4--stat file)))
         buffers)
    (save-window-excursion
      (unwind-protect
          (progn
            (vc-p4-changes file 10)
            (push (current-buffer) buffers)
            (vc-p4-integration-drain)
            (goto-char (point-min)) (search-forward (concat "@" change))
            (button-activate (button-at (1- (point))))
            (push (current-buffer) buffers)
            (vc-p4-integration-drain)
            (should (string-match-p "Submitted changelist @" (buffer-string)))
            (should (string-match-p "move/delete.*(no content)" (buffer-string)))
            ;; g must preserve the view's workspace settings and perform another
            ;; read-only acquisition rather than losing its owning context.
            (revert-buffer t t)
            (vc-p4-integration-drain)
            (should (string-match-p "history-moved.txt#1" (buffer-string)))
            (vc-p4-describe-change "1" file)
            (push (current-buffer) buffers)
            (vc-p4-integration-drain)
            (goto-char (point-min)) (search-forward "//depot/clean.txt#1")
            (button-activate (button-at (1- (point))))
            (push (current-buffer) buffers)
            (vc-p4-integration-drain)
            (should (equal (buffer-string) "unchanged\n"))
            (should (equal vc-p4-history--depot "//depot/clean.txt"))
            (should buffer-read-only)
            (should-not buffer-file-name)
            (should (equal (vc-p4--query directory "opened") opened)))
        (dolist (buffer buffers) (when (buffer-live-p buffer) (kill-buffer buffer)))))))
