;;; vc-p4-integration-tests.el --- Real P4 server contract -*- lexical-binding: t; -*-
(require 'ert)
(require 'vc-p4)
(setq vc-p4-program (or (getenv "VC_P4_PROGRAM") "p4"))

(ert-deftest vc-p4-real-move-and-revert-retarget-visiting-buffer ()
  (let* ((dir (getenv "VC_P4_TEST_ROOT"))
         (old (vc-p4-integration-file "ops-move.txt"))
         (new (expand-file-name "ops moved#@%.txt" dir))
         (added (expand-file-name "ops-move-add.txt" dir))
         (added-new (expand-file-name "ops-move-added-new.txt" dir))
         (vc-handled-backends '(P4)))
    (unwind-protect
        (progn
          (vc-p4-integration-ready new)
          (with-current-buffer (find-file-noselect old)
            (vc-file-setprop old 'vc-backend 'P4)
            (vc-rename-file old new)
            (should (equal buffer-file-name old))
            (vc-p4-integration-drain)
            (should-not (vc-p4--operation-error vc-p4-last-operation))
            (should (equal buffer-file-name new))
            (should (equal (buffer-string) "move lifecycle\n"))
            (should-not (file-exists-p old))
            (should (equal (alist-get 'action (vc-p4--stat new)) "move/add"))
            (let ((depot (alist-get 'movedFile (vc-p4--stat new))))
              (should depot)
              (vc-p4--cached new (list "where" depot)) (vc-p4-integration-drain))
            (vc-revert-file new)
            (vc-p4-integration-drain)
            (should-not (vc-p4--operation-error vc-p4-last-operation))
            (should (equal buffer-file-name old))
            (should-not (file-exists-p new))
            (should (equal (buffer-string) "move lifecycle\n"))
            (should (eq (vc-state old) 'up-to-date)))
          (with-temp-file added (insert "new file to move\n"))
          (vc-p4-register (list added)) (vc-p4-integration-drain)
          (vc-p4-integration-ready added) (vc-p4-integration-ready added-new)
          (vc-file-setprop added 'vc-backend 'P4)
          (vc-rename-file added added-new) (vc-p4-integration-drain)
          (should-not (vc-p4--operation-error vc-p4-last-operation))
          (should-not (file-exists-p added))
          (should (equal (vc-p4--local-bytes added-new) "new file to move\n"))
          (vc-p4-integration-ready added-new)
          (vc-p4-revert added-new) (vc-p4-integration-drain)
          (should-not (vc-p4--operation-error vc-p4-last-operation))
          (should (file-exists-p added-new)))
      (dolist (name (list old new added added-new))
        (when-let* ((buffer (get-file-buffer name)))
          (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer))))))

(ert-deftest vc-p4-real-move-failure-preserves-file-and-reports-partial-state ()
  (let* ((dir (getenv "VC_P4_TEST_ROOT"))
         (old (vc-p4-integration-file "ops-move-fail.txt"))
         (new (expand-file-name "ops-move-target.txt" dir))
         (vc-handled-backends '(P4)) recovery)
    (unwind-protect
        (progn
          (vc-p4--run dir "sync" (concat (vc-p4--escape new) "#none"))
          (vc-p4-integration-ready new)
          (with-current-buffer (find-file-noselect old)
            (vc-file-setprop old 'vc-backend 'P4)
            (vc-rename-file old new) (vc-p4-integration-drain)
            (setq recovery (vc-p4--operation-recovery vc-p4-last-operation))
            (should (vc-p4--operation-error vc-p4-last-operation))
            (should recovery)
            (should (equal buffer-file-name old))
            (should (equal (buffer-string) "keep on failure\n"))
            (should (equal (vc-p4--local-bytes old) "keep on failure\n"))
            ;; Opening succeeded before move failed: expose the real partial state.
            (should (equal (alist-get 'action (vc-p4--stat old)) "edit"))
            (should (equal (vc-p4--local-bytes (expand-file-name "1" recovery)) "keep on failure\n"))))
      (when recovery (delete-directory recovery t))
      (vc-p4--run dir "revert" (vc-p4--escape old))
      (when-let* ((buffer (get-file-buffer old))) (kill-buffer buffer)))))

(ert-deftest vc-p4-real-revert-opened-unopened-added-and-deleted ()
  (let* ((dir (getenv "VC_P4_TEST_ROOT"))
         (file (vc-p4-integration-file "ops-revert.txt"))
         (deleted (vc-p4-integration-file "ops-delete.txt"))
         (added (expand-file-name "ops-revert-add.txt" dir))
         (vc-handled-backends '(P4)) (make-backup-files nil))
    (unwind-protect
        (progn
          (with-current-buffer (find-file-noselect file)
            (vc-file-setprop file 'vc-backend 'P4)
            (vc-checkout file)
            (vc-p4-integration-drain)
            (goto-char (point-max)) (insert "discard this\n") (save-buffer)
            (vc-p4-integration-ready file)
            (maphash (lambda (_ entry) (setf (vc-p4--entry-time entry) 0)) vc-p4--metadata)
            (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
              (vc-revert))
            (should (string-match-p "discard" (buffer-string)))
            (vc-p4-integration-drain)
            (should-not (vc-p4--operation-error vc-p4-last-operation))
            (should (equal (buffer-string) "revert lifecycle\n"))
            (should buffer-read-only)
            (should (eq (vc-state file) 'up-to-date))
            ;; An allwrite-style unopened modification still reverts to HAVE.
            (set-file-modes file #o644) (setq buffer-read-only nil)
            (insert "unopened\n") (save-buffer)
            (vc-p4-integration-ready file)
            (vc-revert-file file)
            (vc-p4-integration-drain)
            (should-not (vc-p4--operation-error vc-p4-last-operation))
            (should (equal (buffer-string) "revert lifecycle\n")))
          (with-temp-file added (insert "keep added text\n"))
          (vc-p4-register (list added)) (vc-p4-integration-drain)
          (vc-p4-integration-ready added)
          (vc-p4-revert added) (vc-p4-integration-drain)
          (should-not (vc-p4--operation-error vc-p4-last-operation))
          (should (equal (vc-p4--local-bytes added) "keep added text\n"))
          (vc-p4-integration-ready added)
          (should-not (vc-p4-registered added))
          (with-current-buffer (find-file-noselect deleted)
            (vc-file-setprop deleted 'vc-backend 'P4)
            (vc-p4-integration-ready deleted)
            (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
              (vc-delete-file deleted))
            (should (file-exists-p deleted))
            (vc-p4-integration-drain)
            (should-not (vc-p4--operation-error vc-p4-last-operation))
            (should-not (file-exists-p deleted))
            (should (eq (vc-state deleted) 'removed))
            (should (buffer-live-p (current-buffer)))
            (vc-revert-file deleted) (vc-p4-integration-drain)
            (should-not (vc-p4--operation-error vc-p4-last-operation))
            (should (equal (vc-p4--local-bytes deleted) "delete lifecycle\n"))
            (should (equal (buffer-string) "delete lifecycle\n"))))
      (dolist (name (list file deleted added))
        (when-let* ((buffer (get-file-buffer name)))
          (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer))))))

(ert-deftest vc-p4-real-revert-stays-clean-when-auto-revert-finishes-first ()
  (require 'autorevert)
  (require 'vc-p4-ops)
  (let* ((file (vc-p4-integration-file "ops-auto-revert.txt"))
         (vc-handled-backends '(P4)) (make-backup-files nil)
         (resynch (symbol-function 'vc-p4--operation-resynch))
         reloaded)
    (unwind-protect
        (with-current-buffer (find-file-noselect file)
          (vc-file-setprop file 'vc-backend 'P4)
          (vc-checkout file) (vc-p4-integration-drain)
          (goto-char (point-max)) (insert "discard this\n") (save-buffer)
          (vc-p4-integration-ready file)
          (auto-revert-mode 1)
          (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                    ((symbol-function 'vc-p4--operation-resynch)
                     (lambda (operation path &optional target keep-text)
                       ;; Deterministically exercise the file-notification race
                       ;; after real P4 has written disk, before our completion.
                       (with-current-buffer (get-file-buffer path)
                         (auto-revert-handler)
                         (should (equal (buffer-string) "auto-revert lifecycle\n"))
                         (should-not (buffer-modified-p))
                         (setq reloaded t))
                       (funcall resynch operation path target keep-text))))
            (vc-revert)
            (vc-p4-integration-drain))
          (should reloaded)
          (should-not vc-p4--operation-error)
          (should-not (buffer-modified-p))
          (should buffer-read-only)
          (should (eq (vc-state file) 'up-to-date))
          (should (equal (buffer-string) "auto-revert lifecycle\n")))
      (vc-p4--run (file-name-directory file) "revert" (vc-p4--escape file))
      (when-let* ((buffer (get-file-buffer file)))
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer)))))

(ert-deftest vc-p4-real-register-literal-paths-and-excluded-file ()
  (let* ((dir (getenv "VC_P4_TEST_ROOT"))
         (file (expand-file-name "new space#@%*.txt" dir))
         (excluded (expand-file-name "excluded/no-add.txt" dir))
         (vc-handled-backends '(P4)) (vc-suppress-confirm t))
    (unwind-protect
        (progn
          (with-current-buffer (find-file-noselect file)
            (insert "new contents\n")
            (vc-file-setprop file 'vc-backend 'Git)
            (cl-letf (((symbol-function 'completing-read)
                       (lambda (&rest _) (ert-fail "Cold P4 discovery offered repository creation"))))
              (vc-register))
            (vc-p4-integration-drain)
            (should-not (vc-p4--operation-error vc-p4-last-operation))
            (should (eq (vc-backend file) 'P4))
            (should (eq (vc-state file) 'added))
            (should (equal (vc-working-revision file) "0"))
            (should (equal (vc-p4--local-bytes file) "new contents\n")))
          (make-directory (file-name-directory excluded) t)
          (with-temp-file excluded (insert "excluded contents\n"))
          (vc-p4-register (list excluded))
          (vc-p4-integration-drain)
          (should (vc-p4--operation-error vc-p4-last-operation))
          (should (equal (vc-p4--local-bytes excluded) "excluded contents\n")))
      (vc-p4--run dir "revert" (vc-p4--escape file))
      (when-let* ((buffer (get-file-buffer file))) (kill-buffer buffer)))))

(ert-deftest vc-p4-real-saved-file-registration-through-native-commands ()
  (let ((dir (getenv "VC_P4_TEST_ROOT"))
        (vc-handled-backends '(Git P4)) (vc-suppress-confirm t))
    (dolist (command '(vc-register vc-next-action))
      (let ((file (expand-file-name (format "saved-%s.txt" command) dir)))
        (unwind-protect
            (with-current-buffer (find-file-noselect file)
              (insert "already saved\n")
              (save-buffer)
              (vc-file-setprop file 'vc-backend 'Git)
              (vc-file-setprop file 'vc-state 'unregistered)
              (call-interactively command)
              (vc-p4-integration-drain)
              (should-not (vc-p4--operation-error vc-p4-last-operation))
              (should (eq (vc-backend file) 'P4))
              (should (eq (vc-state file) 'added))
              (should (equal (alist-get 'action (vc-p4--stat file)) "add"))
              (should (equal (vc-p4--local-bytes file) "already saved\n")))
          (vc-p4--run dir "revert" (vc-p4--escape file))
          (when-let* ((buffer (get-file-buffer file))) (kill-buffer buffer)))))))

(ert-deftest vc-p4-real-registration-through-rejected-git-markers ()
  (let ((root (getenv "VC_P4_TEST_ROOT"))
        (vc-handled-backends '(Git P4)) (vc-suppress-confirm t))
    (dolist (marker '(directory gitfile))
      (let* ((dir (expand-file-name (format "rejected-%s" marker) root))
             (git (expand-file-name ".git" dir)))
        (make-directory dir t)
        (if (eq marker 'directory) (make-directory git)
          (with-temp-file git (insert "not a Git repository\n")))
        (dolist (command '(vc-register vc-next-action))
          (let ((file (expand-file-name (format "%s.txt" command) dir)))
            (unwind-protect
                (with-current-buffer (find-file-noselect file)
                  (insert "saved P4 contents\n")
                  (save-buffer)
                  (vc-file-setprop file 'vc-backend 'none)
                  (should (vc-find-root file ".git"))
                  (call-interactively command)
                  (vc-p4-integration-drain)
                  (should-not vc-p4--operation-error)
                  (should (eq (vc-backend file) 'P4))
                  (should (equal (alist-get 'action (vc-p4--stat file)) "add"))
                  (should (equal (vc-p4--local-bytes file) "saved P4 contents\n")))
              (vc-p4--run dir "revert" (vc-p4--escape file))
              (when-let* ((buffer (get-file-buffer file))) (kill-buffer buffer)))))))))

(ert-deftest vc-p4-real-checkout-permissions-text-and-exclusive-lock ()
  (let* ((file (vc-p4-integration-file "ops-edit.txt"))
         (lock (vc-p4-integration-file "ops-lock.txt"))
         (dir (getenv "VC_P4_TEST_ROOT"))
         (vc-handled-backends '(P4))
         (process-environment (copy-sequence process-environment)))
    (unwind-protect
        (progn
          (with-current-buffer (find-file-noselect file)
            (vc-file-setprop file 'vc-backend 'P4)
            (should buffer-read-only)
            (vc-next-action nil)
            (should buffer-read-only)
            (vc-p4-integration-drain)
            (should-not buffer-read-only)
            (should (equal (buffer-string) "edit lifecycle\n"))
            (should (equal (alist-get 'action (vc-p4--stat file)) "edit"))
            (should (equal (vc-p4-working-revision file) "1")))
          (vc-p4-checkout lock)
          (vc-p4-integration-drain)
          (should-not (vc-p4--operation-error vc-p4-last-operation))
          (setenv "P4USER" "bob") (setenv "P4CLIENT" "bob-client")
          (let* ((bob-file (expand-file-name "../bob/ops-edit.txt" dir))
                 (bob-lock (expand-file-name "../bob/ops-lock.txt" dir)))
            (vc-p4-checkout bob-file)
            (vc-p4-integration-drain)
            (should-not (vc-p4--operation-error vc-p4-last-operation))
            (should (file-writable-p bob-file))
            (vc-p4-checkout bob-lock)
            (vc-p4-integration-drain)
            (should (vc-p4--operation-error vc-p4-last-operation))
            (should (equal (vc-p4--local-bytes bob-lock) "exclusive lifecycle\n"))
            (vc-p4--run dir "revert" (vc-p4--escape bob-file))))
      (setenv "P4USER" "alice") (setenv "P4CLIENT" "alice-client")
      (vc-p4--run dir "revert" (vc-p4--escape file) (vc-p4--escape lock))
      (when-let* ((buffer (get-file-buffer file))) (kill-buffer buffer)))))

(defun vc-p4-integration-drain ()
  "Wait in the test harness until asynchronous backend work settles."
  (let ((deadline (+ (float-time) 10)))
    (while (and (< (float-time) deadline)
                (or vc-p4--queue vc-p4--active vc-p4--diff-tasks
                    vc-p4--dispatch-timer
                    (cl-some (lambda (buffer)
                               (or (buffer-local-value 'vc-p4--notice-timer buffer)
                                   (and (boundp 'vc-p4--waiting-command)
                                        (buffer-local-value 'vc-p4--waiting-command buffer))))
                             (buffer-list))))
      (accept-process-output nil 0.01))
    (should-not vc-p4--queue)
    (should-not vc-p4--active)
    (should-not vc-p4--diff-tasks)
    ;; Let the completion proxy deliver consumer sentinels too.
    (accept-process-output nil 0.02)))

(defun vc-p4-integration-ready (file)
  "Populate FILE's metadata and baseline through real asynchronous workers."
  (dotimes (_ 3)
    (vc-p4-registered file)
    (vc-p4-state file)
    (vc-p4-checkout-model (list file))
    (vc-p4-root file)
    (vc-p4-integration-drain))
  file)

(ert-deftest vc-p4-real-server-have-revision-baseline ()
  (let ((file (getenv "VC_P4_TEST_FILE")))
    (should file)
    (vc-p4-integration-ready file)
    (should (vc-p4-registered file))
    (should (equal (vc-p4-working-revision file) "1"))
    (should (equal (alist-get 'headRev (vc-p4--stat file t)) "2"))
    (should (eq (vc-p4-state file) 'needs-merge))
    (with-temp-buffer
      (vc-p4-find-revision file "1" (current-buffer))
      (should (equal (buffer-string) "one\ntwo\nthree\n")))
    (with-temp-buffer
      (let ((vc-diff-switches '("-U0")))
        (should (= 1 (vc-p4-diff (list file) nil nil (current-buffer)))))
      (should (string-match-p (regexp-quote "-two\n+local edit") (buffer-string)))
      (should-not (string-match-p "new depot line" (buffer-string))))))

(defun vc-p4-integration-file (name)
  "Return fixture path for NAME."
  (vc-p4-integration-ready (expand-file-name name (getenv "VC_P4_TEST_ROOT"))))

(ert-deftest vc-p4-real-server-fixture-configuration ()
  (let* ((dir (getenv "VC_P4_TEST_ROOT"))
         (info (car (vc-p4--query dir "info")))
         (client (car (vc-p4--query dir "client" "-o"))))
    (should (equal (alist-get 'caseHandling info) (getenv "VC_P4_TEST_CASE")))
    (should (equal (alist-get 'LineEnd client) "local"))
    (should-not (alist-get 'Stream client))
    (should (string-match-p "noallwrite" (alist-get 'Options client)))))

(ert-deftest vc-p4-real-server-lifecycle-states ()
  (dolist (entry '(("conflict.txt" . conflict) ("stale.txt" . needs-update)
                   ("clean.txt" . up-to-date) ("opened.txt" . up-to-date)
                   ("unopened.txt" . edited) ("missing.txt" . missing)
                   ("deleted.txt" . removed) ("moved.txt" . removed)
                   ("renamed.txt" . added) ("added.txt" . added)))
    (let ((file (vc-p4-integration-file (car entry))))
      (should (vc-p4-registered file))
      (should (eq (vc-p4-state file) (cdr entry))))))

(ert-deftest vc-p4-real-server-special-paths ()
  (dolist (name '("space name.txt" "special#@%.txt" "café.txt"))
    (let ((file (vc-p4-integration-file name)))
      (should (vc-p4-registered file))
      (should (eq (vc-p4-state file) 'up-to-date)))))

(ert-deftest vc-p4-real-server-content-baselines ()
  (dolist (name '("unicode.txt" "utf16.txt" "crlf.txt" "no-newline.txt" "binary.dat"))
    (let ((file (vc-p4-integration-file name)))
      (should (eq (vc-p4-state file) 'up-to-date))
      (with-temp-buffer
        (should (= 0 (vc-p4-diff (list file) nil nil (current-buffer))))))))

(provide 'vc-p4-integration-tests)

(ert-deftest vc-p4-real-server-root-and-new-file-discovery ()
  (let* ((dir (file-name-as-directory (getenv "VC_P4_TEST_ROOT")))
         (default-directory dir))
    (vc-p4-integration-ready "clean.txt")
    (vc-p4-integration-ready dir)
    (vc-p4-integration-ready (expand-file-name "new.txt" dir))
    (should (equal (vc-p4-root "clean.txt") dir))
    (should (equal (vc-p4-root dir) dir))
    (should (equal (vc-p4-responsible-p (expand-file-name "new.txt" dir)) dir))
    (should-not (vc-p4-registered (expand-file-name "new.txt" dir)))))

(ert-deftest vc-p4-real-server-excluded-mapping ()
  (let ((file (vc-p4-integration-file "excluded/file.txt")))
    (make-directory (file-name-directory file) t)
    (should-not (vc-p4-responsible-p file))
    (should-not (vc-p4-registered file))))

(ert-deftest vc-p4-real-server-checkout-models ()
  (should (eq (vc-p4-checkout-model (list (vc-p4-integration-file "exclusive.txt"))) 'locking))
  (should (eq (vc-p4-checkout-model (list (vc-p4-integration-file "clean.txt"))) 'announce))
  (let ((process-environment (copy-sequence process-environment)))
    (setenv "P4CLIENT" "bob-client")
    (setenv "P4USER" "bob")
    (let ((file (expand-file-name "../bob/clean.txt" (getenv "VC_P4_TEST_ROOT"))))
      (vc-p4-integration-ready file)
      (should (eq (vc-p4-checkout-model (list file)) 'implicit)))))

(ert-deftest vc-p4-real-server-case-variant-discovery ()
  (when (equal (getenv "VC_P4_TEST_CASE") "insensitive")
    (let ((file (vc-p4-integration-file "CLEAN.TXT")))
      (should (vc-p4-registered file))
      (should (equal (vc-p4-working-revision file) "1")))))

(ert-deftest vc-p4-real-server-binary-diff ()
  (let* ((file (vc-p4-integration-file "binary.dat"))
         (original (vc-p4--local-bytes file)))
    (unwind-protect
        (progn
          (set-file-modes file #o644)
          (let ((coding-system-for-write 'no-conversion))
            (write-region (concat original "changed") nil file nil 'silent))
          (with-temp-buffer
            (should (= 1 (vc-p4-diff (list file) nil nil (current-buffer))))
            (should-not (string-match-p "^@@" (buffer-string)))))
      (let ((coding-system-for-write 'no-conversion))
        (write-region original nil file nil 'silent))
      (set-file-modes file #o444))))
