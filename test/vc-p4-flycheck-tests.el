;;; vc-p4-flycheck-tests.el --- Actual Flycheck coexistence -*- lexical-binding: t; -*-
(require 'vc-p4-gutter-tests)
(require 'flycheck)

(ert-deftest vc-p4-flycheck-diagnostic-churn-does-not-touch-diff-markers ()
  (dolist (side '(left-fringe right-fringe))
    (with-temp-buffer
      (insert "one\ntwo\nthree\n")
      (let* ((flycheck-mode t) (flycheck-indication-mode side)
             (diff-hl-side (if (eq side 'left-fringe) 'left 'right))
             (diff-hl-fallback-to-margin nil)
             (flycheck-highlighting-mode 'lines)
             (expected (if (eq side 'left-fringe) 'right-fringe 'left-fringe)))
        (vc-p4-gutter--reconcile '((2 1 1 change)) nil)
        (let* ((marker (car (vc-p4-test-line-overlays)))
               (spec (overlay-get marker 'before-string))
               (error (flycheck-error-new-at 2 1 'warning "Example diagnostic"
                                             :buffer (current-buffer) :checker 'emacs-lisp)))
          (should (eq (caar (get-text-property 0 'display spec)) expected))
          (dotimes (_ 3)
            (let* ((diagnostic (flycheck-add-overlay error))
                   (diagnostic-spec (overlay-get diagnostic 'before-string)))
              (should diagnostic-spec)
              (should (string-match-p (symbol-name side) (format "%S" diagnostic-spec)))
              (vc-p4-gutter--reconcile '((2 1 1 change)) nil)
              (should (eq marker (car (vc-p4-test-line-overlays))))
              (should (eq spec (overlay-get marker 'before-string)))
              (should (eq diagnostic-spec (overlay-get diagnostic 'before-string)))
              (flycheck-delete-all-overlays)
              (vc-p4-gutter--reconcile '((2 1 1 change)) nil)
              (should (eq marker (car (vc-p4-test-line-overlays)))))))))))
